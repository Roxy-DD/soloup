{
  "productName": "Soloup",
  "version": "1.6.2",
  "identifier": "com.soloup.app",
  "build": {
    "frontendDist": "../apps/web/out",
    "beforeBuildCommand": "pnpm --filter @soloup/web build",
    "beforeDevCommand": "pnpm --filter @soloup/web dev",
    "devUrl": "http://localhost:3000"
  },
  "app": {
    "windows": [
      {
        "title": "人生 RPG 面板",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; font-src 'self' https://cdn.jsdelivr.net; connect-src 'self' http://localhost:* ws://localhost:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/icon.ico",
      "icons/icon.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ],
    "externalBin": ["resources/soloup-server", "resources/soloup-mcp"],
    "resources": ["resources/web"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://github.com/Roxy-DD/soloup/releases/latest/download/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg3NjlCNTYzNTE3MTI3N0MKUldSOEozRlJZN1ZwaDNzS1FSMXAxZkE1eVROZEQ1VzVLQVhEb2ZaUkI0cTdhZFBkTFk4VFB1MEYK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}

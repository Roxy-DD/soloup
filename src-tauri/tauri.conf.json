{
  "productName": "Soloup",
  "version": "1.0.1",
  "identifier": "com.soloup.app",
  "build": {
    "frontendDist": "../apps/web/out",
    "beforeBuildCommand": "pnpm --filter @soloup/core build && pnpm --filter @soloup/store build && pnpm --filter @soloup/solver build && pnpm --filter @soloup/web build",
    "beforeDevCommand": "pnpm --filter @soloup/web dev",
    "devUrl": "http://localhost:3000"
  },
  "app": {
    "windows": [
      {
        "title": "人生 RPG 面板",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; font-src 'self' https://cdn.jsdelivr.net; connect-src 'self' http://localhost:* ws://localhost:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ],
    "externalBin": ["resources/soloup-server", "resources/soloup-mcp"],
    "resources": [],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
